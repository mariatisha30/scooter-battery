# Supabase (get from https://supabase.com → your project → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Single password to access the app (you'll type this on the /login screen).
# Pick something memorable but not trivial — at least 12 characters recommended.
APP_PASSWORD=change-me-to-something-strong

# Range calibration defaults
# Your stated baseline: 10–100% gives 135 km, i.e. 1.5 km per percent.
DEFAULT_KM_PER_PCT=1.5
BATTERY_FLOOR_PCT=10

# Passenger mode reduces range — typically ~30% on e-scooters.
# Used until you've logged at least 3 passenger trips to auto-calibrate.
DEFAULT_PASSENGER_FACTOR=0.7
